# ---------- 构建产物 ----------
*.apk
*.aab
*.ap_
*.dex
*.class
build/
*/build/
.gradle/
gradle-app.setting
.gradletasknamecache

# ---------- 本地配置（含 SDK 路径，不应入库） ----------
local.properties

# ---------- Gradle wrapper ----------
# gradlew / gradlew.bat / gradle/wrapper/* 需要入库（固定 Gradle 8.7），只忽略 wrapper 缓存
.gradle/wrapper/

# ---------- IDE ----------
.idea/
*.iml
*.ipr
*.iws
.out/
captures/
.externalNativeBuild/
.cxx/

# ---------- 签名文件（绝对不要提交） ----------
*.jks
*.keystore
*.p12
*.pfx
keystore.properties
signing.properties

# ---------- 系统文件 ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- 日志与临时文件 ----------
*.log
*.hprof
*.tmp
*.bak
*.orig

# ---------- 崩溃 / 运行日志目录（App 导出的本地日志） ----------
crash-*.txt

# ---------- 本机排查用的临时目录（权限诊断报告等） ----------
.acl-recovery/
