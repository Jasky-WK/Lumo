<?xml version="1.0" encoding="utf-8"?>
<!-- 模板记账 4×1（N34）：四个等宽模板槽，每槽「图标 + 分类名」，点某个槽直接按该分类记一笔；
     名称用分类主题色、单行 + ellipsize，四个槽平分宽度，图标与文字都不会被裁切；
     一个支出分类都没有时，用 t_empty 提示条占满整行 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/t_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingTop="6dp"
    android:paddingEnd="10dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:id="@+id/t_slot_1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="2dp"
        android:paddingBottom="2dp">

        <ImageView
            android:id="@+id/t_icon_1"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginBottom="2dp"
            android:contentDescription="@null"
            android:src="@drawable/widget_ic_food" />

        <TextView
            android:id="@+id/t_name_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:text="餐饮"
            android:textColor="@color/widget_sub2"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/t_slot_2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="2dp"
        android:paddingBottom="2dp">

        <ImageView
            android:id="@+id/t_icon_2"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginBottom="2dp"
            android:contentDescription="@null"
            android:src="@drawable/widget_ic_bus" />

        <TextView
            android:id="@+id/t_name_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:text="交通"
            android:textColor="@color/widget_sub2"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/t_slot_3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="2dp"
        android:paddingBottom="2dp">

        <ImageView
            android:id="@+id/t_icon_3"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginBottom="2dp"
            android:contentDescription="@null"
            android:src="@drawable/widget_ic_shop" />

        <TextView
            android:id="@+id/t_name_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:text="购物"
            android:textColor="@color/widget_sub2"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/t_slot_4"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="2dp"
        android:paddingBottom="2dp">

        <ImageView
            android:id="@+id/t_icon_4"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginBottom="2dp"
            android:contentDescription="@null"
            android:src="@drawable/widget_ic_fun" />

        <TextView
            android:id="@+id/t_name_4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:text="娱乐"
            android:textColor="@color/widget_sub2"
            android:textSize="10sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/t_empty"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:text="还没有支出分类，点这里去添加"
        android:textColor="@color/widget_sub"
        android:textSize="11sp"
        android:visibility="gone" />
</LinearLayout>
