<?xml version="1.0" encoding="utf-8"?>
<!-- 快速记一笔 3×1：左边两行小字（账本名 · 今日 / 今日支出金额 + 收入·结余），右边「＋ 记一笔」按钮，
     按钮宽度收窄、字号缩小，全文单行 + ellipsize，保证金额与按钮都不被裁切 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/q_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="10dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/q_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="日常账本 · 今日"
            android:textColor="@color/widget_sub"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/q_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="¥0.00"
                android:textColor="@color/widget_amount"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/q_footer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="end"
                android:maxLines="1"
                android:text="收入 0.00 · 结余 0.00"
                android:textColor="@color/widget_sub2"
                android:textSize="9.5sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/q_add"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:background="@drawable/widget_add_btn"
        android:gravity="center"
        android:minWidth="68dp"
        android:paddingStart="10dp"
        android:paddingTop="7dp"
        android:paddingEnd="10dp"
        android:paddingBottom="7dp"
        android:text="＋ 记一笔"
        android:textColor="@color/widget_btn_fg"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>
